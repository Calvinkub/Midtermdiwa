def parse_sse(chunk):
    # Split on "\n\n"; collect each event's data: payload(s) in order.
    # Stop at [DONE]; skip events with no data: line.

    results = []

    events = chunk.split("\n\n")

    for event in events:
        data_lines = []

        for line in event.splitlines():
            if line.startswith("data:"):
                value = line[5:]  # remove "data:"
                
                # remove exactly ONE leading space
                if value.startswith(" "):
                    value = value[1:]

                data_lines.append(value)

        # skip comments / empty events
        if not data_lines:
            continue

        payload = "\n".join(data_lines)

        if payload == "[DONE]":
            break

        results.append(payload)

    return results
