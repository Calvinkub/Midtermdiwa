def check_response(response, must_include):
    # 1) safely pull response['choices'][0]['message']['content']
    # 2) return True iff every needle is a case-insensitive substring

    content = ""

    try:
        content = response.get("choices", [])[0].get("message", {}).get("content") or ""
    except (IndexError, AttributeError):
        content = ""

    content = content.lower()

    return all(
        needle.lower() in content
        for needle in must_include
    )
