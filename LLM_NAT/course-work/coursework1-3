def build_messages(history, user_msg, system_prompt):
    messages = [
        {"role": "system", "content": system_prompt}
    ]

    for turn in history:
        messages.append({
            "role": "user",
            "content": turn["user"]
        })
        messages.append({
            "role": "assistant",
            "content": turn["assistant"]
        })

    messages.append({
        "role": "user",
        "content": user_msg
    })

    return messages
